{
  "name": "canteumanovacancao",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "eject": "expo eject",
    "localhost": "npm install && npx expo start --localhost",
    "lan": "npm install && npx expo start --lan",
    "tunnel": "npm install && npx expo start --tunnel",
    "build:android": "eas build --platform android",
    "build:ios": "eas device:create && eas build --platform ios",
    "build:apk": "eas build -p android --profile preview",
    "build:dev-android": "eas build --profile development --platform android",
    "build:dev-ios": "eas build --profile development-simulator --platform ios",
    "dependecies-in-use": "npx depcheck"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "expo": "^53.0.22",
    "expo-av": "~15.1.7",
    "expo-clipboard": "~7.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-navigation-bar": "~4.2.8",
    "expo-network": "~7.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "moti": "^0.25.4",
    "qs": "^6.10.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-modalize": "^2.1.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-toast-notifications": "^3.3.1",
    "react-native-track-player": "^5.0.0-alpha0-nightly-359af5a12d712d3b685530aed9b9625865a25d74",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.1",
    "@types/styled-components-react-native": "^5.1.3"
  },
  "private": true
}
